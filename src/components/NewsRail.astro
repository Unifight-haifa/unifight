---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LANGS, t, type Lang } from '../i18n/ui';
import { CHANGES, TODAY, venues } from '../lib/changes';
import { getPosts, postPath } from '../lib/news';
import { GATE_JS, summaryHtml } from '../lib/schedule-changes.mjs';
import NewsRailList from './NewsRailList.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const UI = {
  pause: { he: 'עצירת רצועת החדשות', ru: 'Остановить ленту новостей', en: 'Pause the news ticker' },
  sched: { he: 'שינוי בלוח האימונים', ru: 'Изменение расписания', en: 'Schedule change' },
};
// a post missing this language links to the first translation it has
const posts = (await getPosts()).slice(0, 8).map((p) => {
  const l = p.lang[lang] ? lang : LANGS.find((x) => p.lang[x])!;
  return { href: postPath(l, p.slug), slug: p.slug, title: p.lang[l].data.title, lang: l === lang ? undefined : l, date: p.date };
});
const changes = CHANGES.map((c) => ({ c, html: summaryHtml(c, lang, venues), href: `${getRelativeLocaleUrl(lang)}#chg-${c.id}` }));
const n = posts.length + changes.length;
const shown = posts.length + CHANGES.filter((c) => c.show <= TODAY).length;
const list = { posts, changes, lang, kinds: { news: t(lang, 'newsTitle'), sched: UI.sched[lang] } };
const all = getRelativeLocaleUrl(lang, 'news/');
const go = lang === 'he' ? '←' : '→';
// The loop starts only when the cards overflow the rail; its copy keeps clicks but leaves tab order and the a11y tree.
// Clicked news titles get a view-transition-name matching the post's h1, so the card morphs into the header.
const JS = `(()=>{const r=document.querySelector('.nr'),v=r.querySelector('.nr-view'),t=v.firstElementChild,l=t.firstElementChild,b=r.querySelector('.nr-pause'),m=matchMedia('(prefers-reduced-motion: reduce)');let c;
const fit=()=>{const on=!m.matches&&l.offsetHeight>v.clientHeight+1;if(on===!!c)return;if(on){c=l.cloneNode(true);c.setAttribute('aria-hidden','true');c.querySelectorAll('a').forEach(a=>a.tabIndex=-1);t.append(c)}else{c.remove();c=null}r.toggleAttribute('data-loop',on);b.hidden=!on};
const ro=new ResizeObserver(fit);ro.observe(v);ro.observe(l);m.addEventListener('change',fit);
b.addEventListener('click',()=>{const p=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',p);r.toggleAttribute('data-paused',p)});
let named;document.addEventListener('click',e=>{const a=e.target.closest&&e.target.closest('a[data-vt]');if(!a)return;if(named)named.style.viewTransitionName='';named=a.querySelector('.nr-t,h2');named.style.viewTransitionName='news-'+a.dataset.vt})})();`;
---
{n > 0 && (
  <Fragment>
    <aside class="nr" aria-labelledby="nr-h">
      <div class="nr-top">
        <span id="nr-h">{t(lang, 'newsTitle')}</span>
        <button type="button" class="nr-pause" hidden aria-pressed="false" aria-label={UI.pause[lang]}></button>
      </div>
      <div class="nr-view">
        <div class="nr-track" style={`--n:${n}`}>
          <NewsRailList {...list} />
        </div>
      </div>
      <a class="nr-all" href={all}>{t(lang, 'newsAll')} <span aria-hidden="true">{go}</span></a>
    </aside>
    <details class="nr-m">
      <summary>{t(lang, 'newsTitle')} <span class="nr-n">{shown}</span></summary>
      <div class="nr-m-body">
        <NewsRailList {...list} />
        <a class="nr-all" href={all}>{t(lang, 'newsAll')} <span aria-hidden="true">{go}</span></a>
      </div>
    </details>
    <script is:inline set:html={GATE_JS + JS} />
  </Fragment>
)}

<style>
  :global(html) {
    --nr-w: 0px;
  }
  .nr,
  .nr-m {
    display: none;
  }
  .nr-all {
    display: block;
    padding: 8px 4px;
    color: var(--gold-2);
    font: 500 13px/1.3 var(--body);
    text-decoration: none;
  }
  .nr-all:hover {
    text-decoration: underline;
  }
  @media (min-width: 1100px) {
    :global(html) {
      --nr-w: 196px;
    }
    /* reserve the column so the rail never covers page content */
    :global(body:has(.nr)) {
      padding-inline-end: var(--nr-w);
    }
    :global(body:has(.nr) .hd) {
      inset-inline-end: var(--nr-w);
    }
    /* sized to its cards: one post is a small card, many fill the column and loop */
    .nr {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset-block-start: 12px;
      inset-inline-end: 12px;
      z-index: 70;
      inline-size: calc(var(--nr-w) - 24px);
      max-block-size: calc(100dvh - 24px);
    }
    .nr-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-block-size: 44px;
      padding-inline-start: 4px;
      color: var(--gold-2);
      font: 600 14px/1 var(--disp);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .nr-view {
      min-block-size: 0;
      overflow: hidden;
    }
    .nr[data-loop] .nr-view {
      mask-image: linear-gradient(transparent, #000 16px, #000 calc(100% - 16px), transparent);
    }
    .nr[data-loop] .nr-track {
      animation: nr-up calc(max(var(--n), 4) * 5s) linear infinite;
    }
    .nr:is(:hover, :focus-within, [data-paused]) .nr-track,
    :global(html.still) .nr-track {
      animation-play-state: paused;
    }
  }
  @keyframes nr-up {
    to {
      transform: translateY(-50%);
    }
  }
  .nr-pause {
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    background: none;
    color: var(--gold-2);
    font: 600 13px/1 var(--body);
    cursor: pointer;
  }
  .nr-pause[hidden] {
    display: none;
  }
  .nr-pause::before {
    content: '❚❚';
  }
  .nr-pause[aria-pressed='true']::before {
    content: '▶\fe0e';
  }

  @media (prefers-reduced-motion: reduce) {
    .nr-view {
      overflow-y: auto;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.chg:target) {
      animation: nr-flash 3s ease-out;
    }
  }
  /* holds the highlight while a long smooth scroll is still landing */
  @keyframes nr-flash {
    0%,
    50% {
      background: rgb(212 168 75 / 0.35);
    }
  }
  :global(.chg) {
    scroll-margin-block: 96px;
  }

  @media (max-width: 1099.98px) {
    :global(body:has(.nr-m)) {
      padding-block-end: 64px;
    }
    .nr-m {
      display: block;
      position: fixed;
      inset-block-end: calc(12px + env(safe-area-inset-bottom, 0px));
      inset-inline-start: 12px;
      z-index: 65;
      background: var(--ink-2);
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 0.5);
    }
    .nr-m[open] {
      inline-size: min(20rem, calc(100vw - 24px));
      border-radius: 14px;
    }
    .nr-m summary {
      display: flex;
      align-items: center;
      gap: 8px;
      min-block-size: 44px;
      padding-inline: 16px;
      color: var(--gold-2);
      font: 600 13px/1 var(--disp);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
    }
    .nr-n {
      padding: 0.25em 0.55em;
      border-radius: 10px;
      background: var(--gold);
      color: var(--ink);
      font: 600 11px/1 var(--body);
    }
    .nr-m-body {
      max-block-size: 60dvh;
      overflow-y: auto;
      padding: 8px 8px 0;
      border-block-start: 1px solid var(--line);
    }
    /* the cookie banner owns the bottom of the screen until answered */
    :global(body:has(.consent:not([hidden]))) .nr-m {
      display: none;
    }
  }
  @media print {
    .nr,
    .nr-m {
      display: none !important;
    }
    :global(body) {
      padding: 0 !important;
    }
  }
</style>
