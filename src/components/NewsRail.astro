---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LANGS, t, type Lang } from '../i18n/ui';
import { CHANGES, TODAY, venues } from '../lib/changes';
import { getPosts, postPath } from '../lib/news';
import { GATE_JS, summaryHtml } from '../lib/schedule-changes.mjs';
import NewsRailList from './NewsRailList.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const UI = {
  pause: { he: 'עצירת רצועת החדשות', ru: 'Остановить ленту новостей', en: 'Pause the news ticker' },
  sched: { he: 'לוח אימונים', ru: 'Расписание', en: 'Schedule' },
};
// a post missing this language links to the first translation it has
const posts = (await getPosts()).slice(0, 8).map((p) => {
  const l = p.lang[lang] ? lang : LANGS.find((x) => p.lang[x])!;
  return { href: postPath(l, p.slug), title: p.lang[l].data.title, lang: l === lang ? undefined : l, date: p.date };
});
const changes = CHANGES.map((c) => ({ c, html: summaryHtml(c, lang, venues), href: `${getRelativeLocaleUrl(lang)}#chg-${c.id}` }));
const n = posts.length + changes.length;
const shown = posts.length + CHANGES.filter((c) => c.show <= TODAY).length;
const list = { posts, changes, lang, label: UI.sched[lang] };
---
{n > 0 && (
  <Fragment>
    <aside class="nr" aria-labelledby="nr-h">
      <div class="nr-top">
        <a id="nr-h" href={getRelativeLocaleUrl(lang, 'news/')}>{t(lang, 'newsTitle')}</a>
        <button type="button" class="nr-pause" aria-pressed="false" aria-label={UI.pause[lang]}></button>
      </div>
      <div class="nr-view">
        <div class="nr-track" style={`--n:${n}`}>
          <NewsRailList {...list} />
          <NewsRailList {...list} dup />
        </div>
      </div>
    </aside>
    <details class="nr-m">
      <summary>{t(lang, 'newsTitle')} <span class="nr-n">{shown}</span></summary>
      <NewsRailList {...list} />
    </details>
    <script is:inline set:html={GATE_JS + `document.querySelector('.nr-pause').addEventListener('click',e=>{const b=e.currentTarget,p=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',p);b.closest('.nr').toggleAttribute('data-paused',p)});`} />
  </Fragment>
)}

<style>
  :global(html) {
    --nr-w: 0px;
  }
  .nr,
  .nr-m {
    display: none;
  }
  @media (min-width: 1100px) {
    :global(html) {
      --nr-w: 168px;
    }
    /* reserve the strip's width so it never covers page content */
    :global(body:has(.nr)) {
      padding-inline-end: var(--nr-w);
    }
    :global(body:has(.nr) .hd) {
      inset-inline-end: var(--nr-w);
    }
    .nr {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset-block: 0;
      inset-inline-end: 0;
      z-index: 70;
      inline-size: var(--nr-w);
      background: rgb(19 17 15 / 0.94);
      border-inline-start: 1px solid var(--line);
    }
    .nr-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      block-size: 56px;
      padding-inline: 12px 0;
      border-block-end: 1px solid var(--line);
    }
    .nr-top a {
      color: var(--gold-2);
      font: 600 15px/1 var(--disp);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .nr-view {
      flex: 1;
      overflow: hidden;
    }
    .nr-track {
      animation: nr-up calc(max(var(--n), 4) * 6s) linear infinite;
    }
    .nr :global(.nr-list) {
      min-block-size: calc(100dvh - 56px);
    }
    .nr:is(:hover, :focus-within, [data-paused]) .nr-track,
    :global(html.still) .nr-track {
      animation-play-state: paused;
    }
  }
  @keyframes nr-up {
    to {
      transform: translateY(-50%);
    }
  }
  .nr-pause {
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    background: none;
    color: var(--gold-2);
    font: 600 14px/1 var(--body);
    cursor: pointer;
  }
  .nr-pause::before {
    content: '❚❚';
  }
  .nr-pause[aria-pressed='true']::before {
    content: '▶\fe0e';
  }

  @media (prefers-reduced-motion: reduce) {
    .nr-track {
      animation: none;
    }
    .nr :global(.nr-list[inert]),
    .nr-pause {
      display: none;
    }
    .nr-view {
      overflow-y: auto;
    }
  }

  @media (max-width: 1099.98px) {
    :global(body:has(.nr-m)) {
      padding-block-end: 64px;
    }
    .nr-m {
      display: block;
      position: fixed;
      inset-block-end: calc(12px + env(safe-area-inset-bottom, 0px));
      inset-inline-start: 12px;
      z-index: 65;
      max-inline-size: min(22rem, calc(100vw - 24px));
      background: var(--ink-2);
      border: 1px solid var(--gold);
      border-radius: 22px;
      box-shadow: 0 0.25rem 1.25rem rgb(0 0 0 / 0.5);
    }
    .nr-m[open] {
      border-radius: 12px;
    }
    .nr-m summary {
      display: flex;
      align-items: center;
      gap: 8px;
      min-block-size: 44px;
      padding-inline: 16px;
      color: var(--gold-2);
      font: 600 14px/1 var(--body);
      cursor: pointer;
    }
    .nr-n {
      padding: 0.2em 0.5em;
      border-radius: 10px;
      background: var(--gold);
      color: var(--ink);
      font-size: 12px;
    }
    .nr-m :global(.nr-list) {
      max-block-size: 60dvh;
      overflow-y: auto;
      border-block-start: 1px solid var(--line);
    }
    /* the cookie banner owns the bottom of the screen until answered */
    :global(body:has(.consent:not([hidden]))) .nr-m {
      display: none;
    }
  }
  @media print {
    .nr,
    .nr-m {
      display: none !important;
    }
    :global(body) {
      padding: 0 !important;
    }
  }
</style>
