---
interface Props {
  groups: { medal: 'gold' | 'silver' | 'bronze'; heading: string; athletes: { name: string; weight: string; years: string }[] }[];
}
const { groups } = Astro.props;
const PLACE = { gold: 1, silver: 2, bronze: 3 };
---
<div class="pd" data-reveal>
  {groups.map((g) => (
    <section class={`pd-col md-${g.medal}`} aria-labelledby={`pd-${g.medal}`}>
      <h2 class="pd-step" id={`pd-${g.medal}`}><b class="pd-place" aria-hidden="true">{PLACE[g.medal]}</b><span>{g.heading}</span></h2>
      <ul class="pd-list">
        {g.athletes.map((a) => (
          <li class="pd-card">
            <span class="pd-name">{a.name}</span>
            <span class="pd-meta"><span class="pd-w">{a.weight}</span><span class="pd-y">{a.years}</span></span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
