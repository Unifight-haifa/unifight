---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { MEDAL } from '../lib/news';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  cover: ImageMetadata;
  coverAlt: string;
  medals: { gold: number; silver: number; bronze: number; note?: string };
}
const { lang, slug, title, cover, coverAlt, medals } = Astro.props;
const tally = { he: 'מדליות', ru: 'Медали', en: 'Medals' };
---
<header class="nh">
  <div class="nh-ph">
    <Image src={cover} alt={coverAlt} widths={[600, 1200]} sizes="(min-width: 900px) 380px, 100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="nh-txt">
    <h1 class="h2 nh-h" style={`view-transition-name: news-${slug}`}>{title}</h1>
    <div class="nh-board">
      <span class="nh-rank" aria-hidden="true"><bdi dir="ltr">#1</bdi></span>
      <ul class="nh-tally" aria-label={tally[lang]}>
        {(['gold', 'silver', 'bronze'] as const).map((m) => (
          <li class={`nh-m md-${m}`}><b class="md-disc">{medals[m]}</b><span>{MEDAL[m][lang]}</span></li>
        ))}
      </ul>
    </div>
    {medals.note && <p class="nh-note">{medals.note}</p>}
  </div>
</header>
