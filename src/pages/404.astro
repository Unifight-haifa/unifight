---
import LangPick from '../components/LangPick.astro';
import { LANGS, dir, t } from '../i18n/ui';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404</title>
    <meta name="description" content={t('he', 'notFoundTitle')} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <main>
      {LANGS.map((l) => (
        <section lang={l} dir={dir(l)} data-404={l}>
          <h1>{t(l, 'notFoundTitle')}</h1>
          <a href={base + l + '/'}>{t(l, 'notFoundHome')}</a>
          <p><a href={base + l + '/accessibility/'}>{t(l, 'accessibilityStatement')}</a></p>
        </section>
      ))}
    </main>
    <LangPick mode="reveal" />
  </body>
</html>
