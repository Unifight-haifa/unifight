---
import LangPick from '../components/LangPick.astro';
import { LANGS, dir, t } from '../i18n/ui';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404</title>
  </head>
  <body>
    <main>
      {LANGS.map((l) => (
        <section lang={l} dir={dir(l)} data-404={l}>
          <h1>{t(l, 'notFoundTitle')}</h1>
          <a href={base + l + '/'}>{t(l, 'notFoundHome')}</a>
        </section>
      ))}
    </main>
    <LangPick mode="reveal" />
  </body>
</html>
