---
import LangPick from '../components/LangPick.astro';
import { LANGS, NAMES, t } from '../i18n/ui';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t('he', 'siteName')}</title>
    <LangPick mode="redirect" />
  </head>
  <body>
    <ul>
      {LANGS.map((l) => (
        <li><a href={base + l + '/'} lang={l}>{NAMES[l]}</a></li>
      ))}
    </ul>
  </body>
</html>
