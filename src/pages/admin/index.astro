---
import Fonts from '../../components/Fonts.astro';
import { NAMES } from '../../i18n/ui';
import '../../styles/tokens.css';

// Public values only: the Google client id and the Worker URL. Secrets live in the Worker.
const cfg = JSON.stringify({ api: import.meta.env.PUBLIC_ADMIN_API || null, google: import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || null }).replace(/</g, '\\u003c');
const LANGS = [['he', 'rtl'], ['ru', 'ltr'], ['en', 'ltr']] as const;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Unifight · панель</title>
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <Fonts lang="ru" />
    <script type="application/json" id="cfg" set:html={cfg} />
  </head>
  <body>
    <main>
      <h1 data-t="title">Unifight · панель</h1>
      <p id="notice" hidden data-t="notConfigured">Панель ещё не подключена.</p>

      <section id="signin" hidden>
        <p data-t="signinLead"></p>
        <div id="gsi"></div>
        <form id="tgcode" hidden>
          <label><span data-t="tgCodeLabel"></span>
            <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required dir="ltr" />
          </label>
          <button data-t="tgCodeSubmit"></button>
        </form>
      </section>

      <section id="who" hidden>
        <span data-t="signedInAs"></span> <b id="who-email" dir="ltr"></b>
        <label><span data-t="uiLang"></span>
          <select id="uilang">{LANGS.map(([l]) => <option value={l}>{NAMES[l]}</option>)}</select>
        </label>
        <button id="signout" data-t="signOut"></button>
      </section>

      <p id="status" role="status" aria-live="polite"></p>

      <section id="picker" hidden>
        <label><span data-t="coachPick"></span> <select id="coach"></select></label>
      </section>

      <section id="profile" hidden>
        <h2 data-t="profile"></h2>
        <form id="profile-form">
          <fieldset class="src">
            <legend data-t="sourceLang"></legend>
            {LANGS.map(([l], i) => <label><input type="radio" name="source" value={l} checked={i === 1} /> {NAMES[l]}</label>)}
          </fieldset>
          {['bio', 'dan_rank', 'alt'].map((f) => (
            <fieldset>
              <legend data-t={{ bio: 'bio', dan_rank: 'danRank', alt: 'alt' }[f]}></legend>
              <div class="tri">
                {LANGS.map(([l, d]) => (
                  <label><span>{NAMES[l]}</span><textarea name={`${f}.${l}`} lang={l} dir={d} rows={f === 'bio' ? 5 : 2}></textarea></label>
                ))}
              </div>
            </fieldset>
          ))}
          {['about', 'approach'].map((f) => (
            <fieldset data-list={f}>
              <legend data-t={f}></legend>
              {f === 'approach' && <label><input type="checkbox" name="approach_own" /> <span data-t="approachOwn"></span></label>}
              <div class="paras"></div>
              <button type="button" class="add" data-t="addPara"></button>
            </fieldset>
          ))}
          <div class="actions">
            <button type="button" id="translate" data-t="translate"></button>
            <button id="save" data-t="save"></button>
            <button type="button" id="reload" hidden data-t="reload"></button>
          </div>
        </form>
        <template id="para">
          <fieldset class="para">
            <legend data-t="paragraph"></legend>
            <div class="tri">
              {LANGS.map(([l, d]) => <label><span>{NAMES[l]}</span><textarea data-lang={l} lang={l} dir={d} rows="4"></textarea></label>)}
            </div>
            <button type="button" class="rm" data-t="removePara"></button>
          </fieldset>
        </template>
      </section>

      <section id="photo" hidden>
        <details>
          <summary data-t="photo"></summary>
          <p data-t="photoHint"></p>
          <div id="ph-wrap" dir="ltr"><img id="ph-img" alt="" /><span id="ph-face" hidden></span></div>
          <label class="file"><span data-t="photoPick"></span> <input id="ph-file" type="file" accept="image/*" /></label>
          <button type="button" id="ph-save" disabled data-t="photoSave"></button>
        </details>
      </section>
      <section id="schedule" hidden>
        <details>
          <summary data-t="schedule"></summary>
          <form id="ses-form">
            <div id="ses-rows"></div>
            <div class="row">
              <button type="button" id="ses-add" class="add" data-t="addSession"></button>
              <button id="ses-save" data-t="saveSchedule"></button>
            </div>
          </form>
        </details>
        <details>
          <summary data-t="changes"></summary>
          <ul id="chg-list"></ul>
          <p id="chg-none" hidden data-t="noChanges"></p>
          <form id="chg-form">
            <fieldset class="src">
              <legend data-t="chgType"></legend>
              {['cancel', 'move', 'extra', 'note'].map((ty, i) => <label><input type="radio" name="type" value={ty} checked={i === 0} /> <span data-t={`type.${ty}`}></span></label>)}
            </fieldset>
            <div class="grid">
              <label data-for="cancel move extra" class="wide"><span data-t="chgClass"></span><select name="ses"></select></label>
              <label data-for="cancel move note"><span data-t="chgDate"></span><input type="date" name="date" dir="ltr" /></label>
              <label data-for="cancel note"><span data-t="chgTo"></span><input type="date" name="to" dir="ltr" /></label>
              <label data-for="move extra"><span data-t="chgNewDate"></span><input type="date" name="new_date" dir="ltr" /></label>
              <label data-for="move extra"><span data-t="sesStart"></span><input type="time" name="new_start" dir="ltr" /></label>
              <label data-for="move extra"><span data-t="sesEnd"></span><input type="time" name="new_end" dir="ltr" /></label>
              <label data-for="move extra"><span data-t="sesVenue"></span><select name="new_venue"></select></label>
            </div>
            <fieldset>
              <legend data-t="chgNote"></legend>
              <div class="tri">
                {LANGS.map(([l, d]) => <label><span>{NAMES[l]}</span><textarea name={`note.${l}`} lang={l} dir={d} rows="2"></textarea></label>)}
              </div>
            </fieldset>
            <div class="row">
              <button type="button" id="chg-translate" data-t="translate"></button>
              <button id="chg-save" data-t="publishChange"></button>
            </div>
          </form>
        </details>
        <template id="ses-row">
          <fieldset class="ses">
            <div class="grid">
              <label><span data-t="sesDay"></span><select name="day"></select></label>
              <label><span data-t="sesVenue"></span><select name="venue"></select></label>
              <label><span data-t="sesStart"></span><input type="time" name="start" required dir="ltr" /></label>
              <label><span data-t="sesEnd"></span><input type="time" name="end" required dir="ltr" /></label>
              <label><span data-t="sesKind"></span><select name="kind"></select></label>
              <label><span data-t="sesGrades"></span><span class="gr" dir="ltr"><input type="number" name="g0" min="0" max="12" inputmode="numeric" /> – <input type="number" name="g1" min="0" max="12" inputmode="numeric" /></span></label>
            </div>
            <button type="button" class="rm" data-t="removeSession"></button>
          </fieldset>
        </template>
      </section>

      <section id="telegram" hidden>
        <h2 data-t="telegram"></h2>
        <p id="tg-linked" hidden data-t="tgLinked"></p>
        <button id="tg-connect" data-t="connectTelegram"></button>
        <div id="tg-out" hidden>
          <a id="tg-link" class="big" dir="ltr"></a>
          <p data-t="tgCodeHint"></p>
          <p id="tg-code" class="code" dir="ltr"></p>
          <p id="tg-exp"></p>
        </div>
      </section>

      <section id="access" hidden>
        <h2 data-t="access"></h2>
        <div class="scroll">
          <table>
            <thead><tr><th data-t="accessEmail"></th><th data-t="accessRole"></th><th data-t="accessCoach"></th><th>Telegram</th><th></th></tr></thead>
            <tbody id="access-rows"></tbody>
          </table>
        </div>
        <form id="access-add">
          <label><span data-t="accessEmail"></span><input name="email" type="email" required dir="ltr" autocomplete="off" /></label>
          <label><span data-t="accessRole"></span>
            <select name="role"><option value="coach" data-t="roleCoach"></option><option value="editor" data-t="roleEditor"></option></select>
          </label>
          <label><span data-t="accessCoach"></span><select name="coach_id"></select></label>
          <button data-t="accessAdd"></button>
        </form>
      </section>
    </main>
    <script>
      import '../../admin/app.js';
    </script>
  </body>
</html>

<style is:global>
  main{max-inline-size:1200px;margin-inline:auto;padding:16px var(--gut) 48px}
  h1{font:600 1.4rem var(--disp);color:var(--gold-2);margin-block:0 12px}
  h2{font:600 1.2rem var(--disp);color:var(--gold);margin-block:24px 8px}
  section{margin-block-end:16px}
  label{display:block}
  [hidden]{display:none !important}
  fieldset{border:1px solid var(--line);border-radius:8px;margin:0 0 12px;padding:8px 10px 10px;min-inline-size:0}
  legend{color:var(--gold);padding-inline:4px}
  .src label,#who label{display:inline-block;margin-inline-end:12px}
  .tri{display:grid;gap:8px}
  @media (min-width:900px){.tri{grid-template-columns:repeat(3,1fr)}}
  .tri span{display:block;font-size:.85rem;color:var(--mute)}
  textarea,input,select{box-sizing:border-box;font:inherit;color:var(--paper);background:var(--ink-2);border:1px solid var(--line);border-radius:6px;padding:8px}
  textarea{inline-size:100%;resize:vertical}
  input[name=email],input[name=code]{inline-size:100%;max-inline-size:28rem}
  input[name=code]{font-size:1.6rem;letter-spacing:.3em}
  select,input{min-block-size:44px}
  button{min-block-size:44px;padding:8px 16px;font:inherit;color:var(--ink);background:var(--gold);border:0;border-radius:6px;cursor:pointer}
  button.rm,button.add,#reload,#signout{background:transparent;color:var(--gold-2);border:1px solid var(--line)}
  button:disabled{opacity:.6}
  .actions{display:flex;flex-wrap:wrap;gap:8px;position:sticky;inset-block-end:0;background:var(--ink);padding-block:8px}
  label[data-proposed]::after{content:attr(data-proposed);display:block;font-size:.8rem;color:var(--red-3)}
  #status{min-block-size:1.5em;font-weight:600}
  #status.bad{color:var(--red-3)}
  #status.good{color:var(--gold-2)}
  .scroll{overflow-x:auto}
  table{border-collapse:collapse;inline-size:100%}
  th,td{text-align:start;padding:6px 8px;border-block-end:1px solid var(--line)}
  #access-add{display:grid;gap:8px;margin-block-start:12px;max-inline-size:28rem}
  .big{display:block;font-size:1.2rem;color:var(--gold-2);word-break:break-all;margin-block:8px}
  summary{font:600 1.2rem var(--disp);color:var(--gold);cursor:pointer;min-block-size:44px;display:flex;align-items:center}
  details>*+*{margin-block-start:10px}
  .row{display:flex;flex-wrap:wrap;gap:8px}
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-block-end:8px}
  @media (min-width:900px){.grid{grid-template-columns:repeat(6,minmax(0,1fr))}}
  .grid .wide{grid-column:1/-1}
  .grid label>span[data-t]{display:block;font-size:.85rem;color:var(--mute)}
  .grid select,.grid input{inline-size:100%}
  .grid .gr{display:flex;align-items:center;gap:4px}
  .grid .gr input{inline-size:4.2em}
  #chg-list{padding-inline-start:18px}
  #chg-list li{margin-block-end:8px}
  #chg-list .rm{margin-inline-start:8px}
  #ph-file{max-inline-size:100%}
  #ph-wrap{position:relative;inline-size:fit-content;max-inline-size:100%;overflow:hidden}
  #ph-img{display:block;max-inline-size:min(100%,320px);block-size:auto}
  #ph-img:not([src]),#ph-img[src=""]{display:none}
  #ph-face{position:absolute;inline-size:50%;aspect-ratio:1;border:2px solid var(--gold-2);border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 999px rgb(0 0 0 / .4);pointer-events:none}
  .code{font:600 2.4rem var(--num);letter-spacing:.2em}
</style>
