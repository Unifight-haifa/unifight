---
import landing from '../../generated/landing.html?raw';
import js from '../../generated/landing.js?raw';
import fonts from '../../generated/fonts.json';
import site from '../../../content/site.json';
import { i18n } from 'astro:config/client';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import VenueMap from '../../components/VenueMap.astro';
import { LANGS, type Lang } from '../../i18n/ui';
import '../../styles/landing.css';

export function getStaticPaths() {
  return i18n!.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
// landing.* are produced by the content generator; regenerate rather than hand-edit
let body = landing.replaceAll('%BASE%', import.meta.env.BASE_URL);
for (const l of LANGS) {
  body = body
    .replaceAll(`data-l-link="${l}" href="%LANG_${l}%"`, `${l === lang ? 'aria-current="page"' : `data-set-lang="${l}"`} href="${getRelativeLocaleUrl(l)}"`);
}
body = body.replace(/alt-he="([^"]*)" alt-ru="([^"]*)" alt-en="([^"]*)"/g, (_, he, ru, en) => `alt="${{ he, ru, en }[lang]}"`);
// share scrapers need absolute URLs
const abs = (path: string) => new URL(path, Astro.site).href;
const LOCALE = { he: 'he_IL', ru: 'ru_RU', en: 'en_US' };
// the map is an Astro component, so it is slotted into the generated HTML at a marker
const [beforeMap, afterMap] = body.split('<!--VENUE_MAP-->');
const title = `${site.club.name[lang]} · ${site.hero.headline[lang]}`;
const desc = site.hero.subline[lang];
---
<Base lang={lang} bare>
  <Fragment slot="head">
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(getRelativeLocaleUrl(lang))} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(getRelativeLocaleUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(import.meta.env.BASE_URL)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.club.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(getRelativeLocaleUrl(lang))} />
    <meta property="og:image" content={abs(`${import.meta.env.BASE_URL}og/${lang}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {(fonts as string[]).map((href) => <link rel="stylesheet" href={href} />)}
  </Fragment>
  <Fragment set:html={beforeMap} />
  <VenueMap lang={lang} />
  <Fragment set:html={afterMap} />
  <script is:inline set:html={js} />
</Base>
