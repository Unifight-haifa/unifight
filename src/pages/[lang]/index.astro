---
import landing from '../../generated/landing.html?raw';
import js from '../../generated/landing.js?raw';
import site from '../../../content/site.json';
import venues from '../../../content/venues.json';
import geo from '../../../content/venues-geo.json';
import { Font } from 'astro:assets';
import { i18n } from 'astro:config/client';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import VenueMap from '../../components/VenueMap.astro';
import JsonLd from '../../components/JsonLd.astro';
import VideoModal from '../../components/VideoModal.astro';
import { LANGS, t, type Lang } from '../../i18n/ui';
import { GA_ID } from '../../lib/analytics';
import { CHANGES, TODAY, schedules } from '../../lib/changes';
import { GATE_JS, fillSchedule, renderSchedule } from '../../lib/schedule-changes.mjs';
import '../../styles/landing.css';

export function getStaticPaths() {
  return i18n!.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
// landing.* are produced by the content generator; regenerate rather than hand-edit
let body = landing.replaceAll('%BASE%', import.meta.env.BASE_URL);
for (const l of LANGS) {
  body = body
    .replaceAll(`data-l-link="${l}" href="%LANG_${l}%"`, `${l === lang ? 'aria-current="page"' : `data-set-lang="${l}"`} href="${getRelativeLocaleUrl(l)}"`);
}
body = body.replace('<!--COOKIES-->', GA_ID ? ` · <button type="button" class="consent-open" data-consent-open>${t(lang, 'cookieSettings')}</button>` : '');
body = body.replace(/([a-z-]+)-he="([^"]*)" \1-ru="([^"]*)" \1-en="([^"]*)"/g, (_, a, he, ru, en) => `${a}="${{ he, ru, en }[lang]}"`);
// dated schedule changes go into the markers build.py leaves in the schedule
const colors = Object.fromEntries([...body.matchAll(/data-c="([a-z-]+)"[^>]*--cc:(#\w+)/g)].map((m) => [m[1], m[2]]));
body = fillSchedule(body, renderSchedule(CHANGES, lang, TODAY, schedules, venues, colors));
// share scrapers need absolute URLs
const abs = (path: string) => new URL(path, Astro.site).href;
const LOCALE = { he: 'he_IL', ru: 'ru_RU', en: 'en_US' };
// the map is an Astro component, so it is slotted into the generated HTML at a marker
const [beforeMap, afterMap] = body.split('<!--VENUE_MAP-->');
const title = `${site.club.name[lang]} · ${site.hero.headline[lang]}`;
const desc = site.hero.subline[lang];
// SportsClub alone has no `sport`; that comes from SportsOrganization
const club = {
  '@context': 'https://schema.org',
  '@type': ['SportsClub', 'SportsOrganization'],
  '@id': abs(`${import.meta.env.BASE_URL}#club`),
  name: site.club.name[lang],
  description: desc,
  url: abs(getRelativeLocaleUrl(lang)),
  logo: abs(`${import.meta.env.BASE_URL}${site.club.logo}`),
  sameAs: site.contact.social.filter((s) => s.confidence === 'confirmed').map((s) => s.url),
  telephone: '+972-54-763-2054',
  email: site.contact.email.value,
  sport: 'Judo',
  location: Object.entries(venues).map(([id, v]) => {
    const [streetAddress, addressLocality] = v.address[lang].split(/, (?=[^,]+$)/);
    const g = geo[id as keyof typeof geo];
    return {
      '@type': 'Place',
      name: v[lang],
      address: { '@type': 'PostalAddress', streetAddress, addressLocality, addressCountry: 'IL' },
      // venues without a reliable geocode stay off the map (content/venues-geo.json)
      ...(g ? { geo: { '@type': 'GeoCoordinates', latitude: g.lat, longitude: g.lng } } : {}),
    };
  }),
};
---
<Base lang={lang} bare>
  <Fragment slot="head">
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(getRelativeLocaleUrl(lang))} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(getRelativeLocaleUrl(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(import.meta.env.BASE_URL)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.club.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(getRelativeLocaleUrl(lang))} />
    <meta property="og:image" content={abs(`${import.meta.env.BASE_URL}og/${lang}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={club} />
    {/* success triangle headings */}
    <Font cssVariable="--font-playfair" />
    <Font cssVariable="--font-frank" />
  </Fragment>
  <Fragment set:html={beforeMap} />
  <VenueMap lang={lang} />
  <Fragment set:html={afterMap} />
  <VideoModal lang={lang} />
  <script is:inline set:html={GATE_JS + js} />
</Base>
