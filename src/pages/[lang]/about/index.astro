---
import { Image } from 'astro:assets';
import { i18n } from 'astro:config/client';
import { getRelativeLocaleUrl } from 'astro:i18n';
import site from '../../../../content/site.json';
import venues from '../../../../content/venues.json';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { t, type Lang } from '../../../i18n/ui';
import { about, photo, tournamentPath, tournaments, tr, type T } from '../../../lib/club';
import { bidi, published } from '../../../lib/club-check.mjs';
import '../../../styles/landing.css';
import '../../../styles/news.css';
import '../../../styles/club.css';

export function getStaticPaths() {
  return i18n!.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = {
  he: {
    title: 'על המועדון',
    desc: 'מועדון הג׳ודו יוניפייט חיפה: העמותה, ההנהלה והמאמנים, הענפים, האולמות והתחרויות שארגנו.',
    team: 'הנהלה ומאמנים',
    teamText: (n: number) => `בצוות המועדון ${n} מאמנים.`,
    teamLink: 'כל המאמנים',
    venues: 'איפה מתאמנים',
    venuesText: (n: number, cities: string) => `${n} אולמות: ${cities}.`,
    venuesLink: 'כתובות ומפה',
    events: 'תחרויות שארגנו',
    results: 'הישגים',
    resultsLink: 'כל ההישגים',
    story: 'הסיפור שלנו',
  },
  ru: {
    title: 'О клубе',
    desc: 'Клуб дзюдо «Юнифайт Хайфа»: амута, руководство и тренеры, виды спорта, залы и турниры, которые мы провели.',
    team: 'Руководство и тренера',
    teamText: (n: number) => `Тренеров в клубе: ${n}.`,
    teamLink: 'Все тренера',
    venues: 'Где тренируемся',
    venuesText: (n: number, cities: string) => `Залов: ${n}. ${cities}.`,
    venuesLink: 'Адреса и карта',
    events: 'Турниры, которые мы провели',
    results: 'Достижения',
    resultsLink: 'Все достижения',
    story: 'История клуба',
  },
  en: {
    title: 'About the club',
    desc: 'The Unifight Haifa judo club: the association, its leadership and coaches, disciplines, venues and the tournaments we have run.',
    team: 'Leadership and coaches',
    teamText: (n: number) => `The club has ${n} coaches.`,
    teamLink: 'All coaches',
    venues: 'Where we train',
    venuesText: (n: number, cities: string) => `${n} venues in ${cities}.`,
    venuesLink: 'Addresses and map',
    events: 'Tournaments we have run',
    results: 'Achievements',
    resultsLink: 'All achievements',
    story: 'Our story',
  },
}[lang];

type Coach = { id: string; group: string; order: number; name: T; role?: T };
const coaches = Object.values(import.meta.glob<Coach>('../../../../content/coaches/[!_]*.json', { eager: true, import: 'default' }));
const lead = coaches.filter((c) => c.group === 'main').sort((a, b) => a.order - b.order);
const cities = [...new Set(Object.values(venues).map((v) => v.address[lang].split(', ').pop()))];
const events = [...tournaments].sort((a, b) => b.date.localeCompare(a.date));
const stats = published(site.achievements.stats) as { value: string; label: T }[];
const home = getRelativeLocaleUrl(lang);
const title = `${s.title} · ${t(lang, 'siteName')}`;
const abs = (p: string) => new URL(p, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: abs(getRelativeLocaleUrl(lang, 'about/')),
  name: title,
  mainEntity: { '@id': abs(`${import.meta.env.BASE_URL}#club`) },
};
---
<Base lang={lang} title={title} description={s.desc}>
  <Fragment slot="head">
    <PageHead lang={lang} path="about/" title={title} desc={s.desc} />
    <JsonLd data={ld} />
  </Fragment>
  <div class="news club">
    <h1 class="h2">{s.title}</h1>
    <p class="lead" set:html={bidi(lang, site.footer.tagline[lang])} />
    <section class="club-about" aria-labelledby="amuta">
      <div>
        <h2 class="h3" id="amuta">{about.title[lang]}</h2>
        <dl>
          {about.facts.map((f) => (
            <div>
              <dt>{f.label[lang]}</dt>
              <dd>{f.href ? <a href={f.href} rel="noopener"><bdi dir="ltr">{tr(f.value, lang)}</bdi></a> : <span set:html={bidi(lang, tr(f.value, lang))} />}</dd>
            </div>
          ))}
        </dl>
      </div>
      <Image src={photo(about.photo)} alt={about.alt[lang]} widths={[400, 800]} sizes="(min-width: 900px) 320px, 100vw" />
    </section>
    <section aria-labelledby="team">
      <h2 class="h3" id="team">{s.team}</h2>
      <ul class="club-slots">
        {lead.map((c) => <li><strong>{c.name[lang]}</strong>{c.role && <span>{c.role[lang]}</span>}</li>)}
      </ul>
      <p class="club-empty" set:html={bidi(lang, s.teamText(coaches.length))} />
      <a class="news-back" href={`${home}#coaches`}>{s.teamLink} <span class="arrow" aria-hidden="true">→</span></a>
    </section>
    <section aria-labelledby="venues">
      <h2 class="h3" id="venues">{s.venues}</h2>
      <p class="club-empty" set:html={bidi(lang, s.venuesText(Object.keys(venues).length, cities.join(', ')))} />
      <a class="news-back" href={getRelativeLocaleUrl(lang, 'contact/')}>{s.venuesLink} <span class="arrow" aria-hidden="true">→</span></a>
    </section>
    <section aria-labelledby="events">
      <h2 class="h3" id="events">{s.events}</h2>
      <ul class="club-events">
        {events.map((e) => (
          <li>
            <a href={tournamentPath(lang, e.slug)}><bdi dir="ltr">{e.date.slice(0, 4)}</bdi> <strong>{e.name[lang]}</strong></a>
            {e.role && <p class="club-role">{e.role[lang]}</p>}
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="results">
      <h2 class="h3" id="results">{s.results}</h2>
      <dl class="club-facts">
        {stats.map((x) => <div><dt><bdi dir="ltr">{x.value}</bdi></dt><dd set:html={bidi(lang, x.label[lang])} /></div>)}
      </dl>
      <a class="news-back" href={getRelativeLocaleUrl(lang, 'achievements/')}>{s.resultsLink} <span class="arrow" aria-hidden="true">→</span></a>
    </section>
    <section aria-labelledby="story">
      <h2 class="h3" id="story">{s.story}</h2>
      <p class="club-empty" set:html={bidi(lang, site.history.intro[lang])} />
      <a class="news-back" href={getRelativeLocaleUrl(lang, 'history/')}>{s.story} <span class="arrow" aria-hidden="true">→</span></a>
    </section>
  </div>
</Base>
