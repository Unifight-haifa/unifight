---
import { i18n } from 'astro:config/client';
import { site } from '../../lib/site';
import Base from '../../layouts/Base.astro';
import VenueMap from '../../components/VenueMap.astro';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return i18n!.locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const title = site.pages.map.title[lang];
const description = site.pages.map.desc[lang];
---
<Base lang={lang} title={title} description={description} noindex>
  <h1>{title}</h1>
  <VenueMap lang={lang} />
</Base>
