---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import JsonLd from '../../../components/JsonLd.astro';
import VideoLink from '../../../components/VideoLink.astro';
import VideoModal from '../../../components/VideoModal.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { authorName, fmtDate, getPosts, ogCover, postPath, type Post } from '../../../lib/news';
import videos from '../../../../content/videos.json';
import '../../../styles/landing.css';
import '../../../styles/news.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return LANGS.flatMap((lang) => posts.map((post) => ({ params: { lang, slug: post.slug }, props: { post } })));
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props as { post: Post };
const entry = post.lang[lang];
const d = entry.data;
const { Content } = await render(entry);
const abs = (path: string) => new URL(path, Astro.site).href;
const url = abs(postPath(lang, post.slug));
const og = await ogCover(entry);
const video = d.video && videos.find((v) => v.id === d.video);
if (d.video && !video) throw new Error(`news/${post.slug}/${lang}: video ${d.video} is not in content/videos.json`);
const LOCALE = { he: 'he_IL', ru: 'ru_RU', en: 'en_US' };
const e = encodeURIComponent;
const article = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString(),
  image: [abs(og.src)],
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: authorName(d.author, lang) },
  publisher: {
    '@type': 'Organization',
    '@id': abs(`${import.meta.env.BASE_URL}#club`),
    name: t(lang, 'siteName'),
    logo: abs(`${import.meta.env.BASE_URL}brand/logo.png`),
  },
};
// WhatsApp glyph is the landing's WA_SVG (scripts/landing/build.py)
const share = [
  ['WhatsApp', `https://wa.me/?text=${e(`${d.title} ${url}`)}`, 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.6 14.2c-.2.7-1.4 1.3-2 1.3-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.6 13.3 13.3 0 0 1-5-4.5c-.4-.5-1-1.5-1-2.8 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.5c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.1.1.7-.1 1.4Z'],
  // sharer.php is undocumented by Facebook but stable and widely used
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`, 'M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4a22 22 0 0 0-2.5-.1c-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3Z'],
  ['Telegram', `https://t.me/share/url?url=${e(url)}&text=${e(d.title)}`, 'M21.6 4.2 2.9 11.4c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.8-1.3-1.5ZM9.5 14.2l9-5.7c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-1.6-4.6Z'],
];
---
<Base lang={lang} title={`${d.title} · ${t(lang, 'siteName')}`}>
  <Fragment slot="head">
    <meta name="description" content={d.summary} />
    <link rel="canonical" href={url} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(postPath(l, post.slug))} />)}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={t(lang, 'siteName')} />
    <meta property="og:title" content={d.title} />
    <meta property="og:description" content={d.summary} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    {d.cover_alt && <meta property="og:image:alt" content={d.cover_alt} />}
    <meta property="og:locale" content={LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
    <meta property="article:published_time" content={d.date.toISOString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={article} />
  </Fragment>
  <article class="news post">
    <a class="news-back" href={getRelativeLocaleUrl(lang, 'news/')}>{t(lang, 'newsAll')}</a>
    <h1 class="h2" style={`view-transition-name: news-${post.slug}`}>{d.title}</h1>
    <p class="news-meta">
      <time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date, lang)}</time>
      · {t(lang, 'newsBy')} <bdi>{authorName(d.author, lang)}</bdi>
    </p>
    <Image class="news-cover" src={d.cover} alt={d.cover_alt ?? ''} widths={[600, 1200]} sizes="(min-width: 800px) 760px, 100vw" />
    {video && <div class="news-video"><VideoLink v={video} title={video.title[lang]} /></div>}
    <div class="news-body"><Content /></div>
    <footer class="news-end">
      <nav class="news-share" aria-labelledby="news-share-h">
        <span class="news-share-h" id="news-share-h">{t(lang, 'newsShare')}</span>
        <button type="button" class="share-ico" hidden data-share data-title={d.title} data-url={url} aria-label={t(lang, 'newsShare')} data-ga="news_share" data-ga-channel="native">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" /></svg>
        </button>
        {share.map(([name, href, icon]) => (
          <a class="share-ico" href={href} target="_blank" rel="noopener" aria-label={name} data-ga="news_share" data-ga-channel={name.toLowerCase()}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={icon} /></svg>
          </a>
        ))}
        <a class="share-ico" href={url} data-copy aria-label={t(lang, 'newsCopy')} data-done={t(lang, 'newsCopied')} data-ga="news_share" data-ga-channel="copy">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L12 5.6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2" /></svg>
        </a>
        <span class="share-status" role="status" aria-live="polite"></span>
      </nav>
      <a class="news-back" href={getRelativeLocaleUrl(lang, 'news/')}>{t(lang, 'newsAll')}</a>
    </footer>
  </article>
  {video && <VideoModal lang={lang} />}
  <script is:inline>
    (function () {
      var nav = document.querySelector('.news-share'), status = nav.querySelector('.share-status');
      var say = function (s) { status.textContent = s; setTimeout(function () { status.textContent = ''; }, 2500); };
      var native = nav.querySelector('[data-share]');
      // phones get the system sheet; desktops keep the icons, where it is often a thin Windows/macOS dialog
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        native.hidden = false;
        nav.classList.add('is-native');
      }
      nav.addEventListener('click', function (e) {
        if (e.target.closest('[data-share]')) {
          navigator.share({ title: native.dataset.title, url: native.dataset.url }).catch(function (err) {
            if (err.name !== 'AbortError') nav.classList.remove('is-native');
          });
          return;
        }
        var a = e.target.closest('[data-copy]');
        if (!a) return;
        e.preventDefault();
        var done = function () { a.classList.add('is-done'); say(a.dataset.done); setTimeout(function () { a.classList.remove('is-done'); }, 2500); };
        // clipboard API needs a secure context; prompt lets the user copy by hand
        var manual = function () { window.prompt('', a.href); };
        if (navigator.clipboard) navigator.clipboard.writeText(a.href).then(done, manual);
        else manual();
      });
    })();
  </script>
</Base>
