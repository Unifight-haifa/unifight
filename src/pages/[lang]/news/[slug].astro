---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../../layouts/Base.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { LANGS, t, type Lang } from '../../../i18n/ui';
import { authorName, fmtDate, getPosts, ogCover, postPath, type Post } from '../../../lib/news';
import { socialTexts } from '../../../lib/social.mjs';
import social from '../../../../content/social.json';
import '../../../styles/landing.css';
import '../../../styles/news.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return LANGS.flatMap((lang) => posts.map((post) => ({ params: { lang, slug: post.slug }, props: { post } })));
}

const lang = Astro.params.lang as Lang;
const { post } = Astro.props as { post: Post };
const entry = post.lang[lang];
const d = entry.data;
const { Content } = await render(entry);
const abs = (path: string) => new URL(path, Astro.site).href;
const url = abs(postPath(lang, post.slug));
const og = await ogCover(entry);
const LOCALE = { he: 'he_IL', ru: 'ru_RU', en: 'en_US' };
const e = encodeURIComponent;
const article = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString(),
  image: [abs(og.src)],
  inLanguage: lang,
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: authorName(d.author, lang) },
  publisher: {
    '@type': 'Organization',
    '@id': abs(`${import.meta.env.BASE_URL}#club`),
    name: t(lang, 'siteName'),
    logo: abs(`${import.meta.env.BASE_URL}brand/logo.png`),
  },
};
const share = [
  ['WhatsApp', `https://wa.me/?text=${e(`${d.title} ${url}`)}`],
  // sharer.php is undocumented by Facebook but stable and widely used
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`],
  ['Telegram', `https://t.me/share/url?url=${e(url)}&text=${e(d.title)}`],
];
const texts = socialTexts({ title: d.title, body: entry.body ?? '', url, hashtags: social.hashtags[lang], linkInBio: social.link_in_bio[lang] });
const copy = [
  ['instagram', 'Instagram', t(lang, 'newsCopyIg')],
  ['youtube', 'YouTube', t(lang, 'newsCopyYt')],
  ['whatsapp', 'WhatsApp', t(lang, 'newsCopyWa')],
] as const;
---
<Base lang={lang} title={`${d.title} · ${t(lang, 'siteName')}`}>
  <Fragment slot="head">
    <meta name="description" content={d.summary} />
    <link rel="canonical" href={url} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(postPath(l, post.slug))} />)}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={t(lang, 'siteName')} />
    <meta property="og:title" content={d.title} />
    <meta property="og:description" content={d.summary} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    {d.cover_alt && <meta property="og:image:alt" content={d.cover_alt} />}
    <meta property="og:locale" content={LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]} />)}
    <meta property="article:published_time" content={d.date.toISOString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={article} />
  </Fragment>
  <article class="news post">
    <a class="news-back" href={getRelativeLocaleUrl(lang, 'news/')}>{t(lang, 'newsAll')}</a>
    <h1 class="h2">{d.title}</h1>
    <p class="news-meta">
      <time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date, lang)}</time>
      · {t(lang, 'newsBy')} <bdi>{authorName(d.author, lang)}</bdi>
    </p>
    <Image class="news-cover" src={d.cover} alt={d.cover_alt ?? ''} widths={[600, 1200]} sizes="(min-width: 800px) 760px, 100vw" />
    <div class="news-body"><Content /></div>
    <nav class="news-share" aria-label={t(lang, 'newsShare')}>
      {share.map(([name, href]) => <a class="btn btn-ghost" href={href} target="_blank" rel="noopener" data-ga="news_share" data-ga-channel={name.toLowerCase()}>{name}</a>)}
      <a class="btn btn-ghost" href={url} data-copy data-ga="news_share" data-ga-channel="copy" data-done={t(lang, 'newsCopied')}>{t(lang, 'newsCopy')}</a>
    </nav>
    <section class="news-social" aria-labelledby="news-social-h">
      <h2 id="news-social-h" class="h3">{t(lang, 'newsSocial')}</h2>
      {copy.map(([id, name, label]) => (
        <div class="news-social-item">
          <button type="button" class="btn btn-ghost" hidden data-copy-text data-ga="news_share" data-ga-channel={`text_${id}`}>{label}</button>
          <details>
            <summary><bdi>{name}</bdi>: {t(lang, 'newsShowText')}</summary>
            <textarea readonly rows="8" aria-label={label}>{texts[id]}</textarea>
          </details>
        </div>
      ))}
      <p class="news-social-status" role="status" aria-live="polite" data-done={t(lang, 'newsTextCopied')} data-select={t(lang, 'newsSelectHint')}></p>
    </section>
  </article>
  <script is:inline>
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-copy]');
      if (!a) return;
      e.preventDefault();
      var done = function () { a.textContent = a.dataset.done; };
      // clipboard API needs a secure context; prompt lets the user copy by hand
      var manual = function () { window.prompt('', a.href); };
      if (navigator.clipboard) navigator.clipboard.writeText(a.href).then(done, manual);
      else manual();
    });
    document.querySelectorAll('[data-copy-text]').forEach(function (b) { b.hidden = false; });
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-copy-text]');
      if (!b) return;
      var box = b.parentNode;
      var ta = box.querySelector('textarea');
      var status = document.querySelector('.news-social-status');
      // clear first so a repeated click is announced again
      var say = function (s) { status.textContent = ''; setTimeout(function () { status.textContent = s; }, 50); };
      var manual = function () {
        box.querySelector('details').open = true;
        ta.focus();
        ta.select();
        say(status.dataset.select);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(ta.value).then(function () { say(status.dataset.done); }, manual);
      else manual();
    });
  </script>
</Base>
