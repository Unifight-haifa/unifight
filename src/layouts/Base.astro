---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Consent from '../components/Consent.astro';
import Fonts from '../components/Fonts.astro';
import NewsRail from '../components/NewsRail.astro';
import { LANGS, NAMES, dir, t, type Lang } from '../i18n/ui';
import { GA_ID } from '../lib/analytics';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** page brings its own header/main/footer */
  bare?: boolean;
}

const { lang, title, description, noindex, bare } = Astro.props;
// path after /<base>/<lang>/; slugs are identical across locales
const rest = Astro.url.pathname.slice(import.meta.env.BASE_URL.length).split('/').slice(1).join('/');
---
<!doctype html>
<html lang={lang} dir={dir(lang)} data-site>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t(lang, 'siteName')}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={`${t(lang, 'newsTitle')} · ${t(lang, 'siteName')}`} href={`${getRelativeLocaleUrl(lang)}rss.xml`} />
    <link rel="alternate" type="application/feed+json" title={t(lang, 'siteName')} href={`${import.meta.env.BASE_URL}feed.json`} />
    <Fonts lang={lang} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skipToContent')}</a>
    {bare ? <slot /> : <Fragment>
    <header class="site-header">
      <a class="site-name" href={getRelativeLocaleUrl(lang)}>{t(lang, 'siteName')}</a>
      <nav aria-label={t(lang, 'langLabel')}>
        {LANGS.filter((l) => l !== lang).map((l) => (
          <a href={getRelativeLocaleUrl(l, rest)} hreflang={l} lang={l} data-set-lang={l} data-ga="language_switch" data-ga-to={l}>{NAMES[l]}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {t(lang, 'siteName')}</span>
      <a href={getRelativeLocaleUrl(lang, 'contact/')}>{t(lang, 'contact')}</a>
      <a href={getRelativeLocaleUrl(lang, 'belts/')}>{t(lang, 'belts')}</a>
      <a href={getRelativeLocaleUrl(lang, 'techniques/')}>{t(lang, 'techniques')}</a>
      <a href={getRelativeLocaleUrl(lang, 'accessibility/')}>{t(lang, 'accessibilityStatement')}</a>
      <a href={getRelativeLocaleUrl(lang, 'privacy/')}>{t(lang, 'privacyPolicy')}</a>
      {GA_ID && <button type="button" class="consent-open" data-consent-open>{t(lang, 'cookieSettings')}</button>}
    </footer>
    </Fragment>}
    <NewsRail lang={lang} />
    <Consent lang={lang} />
    <script is:inline>
      // only an explicit switch counts as a choice; page views never write
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('[data-set-lang]');
        if (a) try { localStorage.setItem('lang', a.dataset.setLang); } catch (err) {}
      });
    </script>
  </body>
</html>
