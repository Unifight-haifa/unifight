{
  "id": "WioJt6Ls1FOcaET1",
  "name": "bot-git-commit",
  "nodes": [
    {
      "id": "9f4f0466-bfb7-4acd-8f15-69963d8295b3",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        144
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "f3d0d9c6-1bca-49b4-8377-3c2621cfa2a8",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        144
      ],
      "parameters": {
        "jsCode": "\n// Callers can only touch bot-owned paths per repo; originals live in the private staging repo, never in the public one.\nconst ALLOWED = {\n  'Unifight-haifa/unifight': ['content/schedule-changes/'],\n  'Unifight-haifa/media-inbox': ['incoming/gallery/'],\n};\nconst r = $input.first().json;\nconst repo = r.repo || 'Unifight-haifa/unifight';\nconst prefixes = ALLOWED[repo];\nif (!prefixes) throw new Error(`bot-git-commit: repo not allowed: ${repo}`);\nconst files = Array.isArray(r.files) ? r.files : [];\nif (!files.length || !r.message) throw new Error('bot-git-commit: files and message are required');\nfor (const f of files) {\n  const p = String(f.path || '');\n  if (!prefixes.some(a => p.startsWith(a)) || p.includes('..') || !/^[\\w./-]+$/.test(p)) throw new Error(`bot-git-commit: path not allowed in ${repo}: ${p}`);\n  if (typeof f.content !== 'string' && typeof f.b64 !== 'string') throw new Error(`bot-git-commit: no content for ${p}`);\n}\nconst d = r.dispatch || null;\nif (d && d.event_type !== 'gallery-intake') throw new Error(`bot-git-commit: dispatch not allowed: ${d.event_type}`);\nreturn [{ json: {\n  files, message: String(r.message), dispatch: d,\n  live_url: r.live_url || '', live_match: r.live_match || '', live_checks: Number(r.live_checks) || 16,\n  cfg: { api: `https://api.github.com/repos/${repo}`, dispatch_api: 'https://api.github.com/repos/Unifight-haifa/unifight/dispatches', branch: r.branch || 'main' },\n} }];\n"
      }
    },
    {
      "id": "59485b7d-e0c0-4507-b08b-27f6a7620df7",
      "name": "Get Ref",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        144
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.cfg.api }}/git/ref/heads/{{ $json.cfg.branch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
