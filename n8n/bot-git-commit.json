        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Config').first().json.message, tree: $json.sha, parents: [$('Get Ref').first().json.object.sha] }) }}",
        "options": {}
      }
    },
    {
      "id": "6b8bb4b0-b2ce-4465-84f8-7f2910e6ec42",
      "name": "Update Ref",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2016,
        144
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.cfg.api }}/git/refs/heads/{{ $('Config').first().json.cfg.branch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2026-03-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sha: $json.sha, force: false }) }}",
        "options": {}
      }
    },
    {
      "id": "f7d5823c-32ee-4e64-8658-a5bb88aa1813",
      "name": "Committed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        144
      ],
      "parameters": {
        "jsCode": "\nconst c = $('Config').first().json;\nreturn [{ json: { sha: $('Create Commit').first().json.sha, live_url: c.live_url, live_match: c.live_match } }];\n"
      }
    },
    {
      "id": "fa5d0a12-f316-492e-b5ca-ba173129b0aa",
      "name": "Wait For Live?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2464,
        144
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ !!$('Config').first().json.live_url && !!$('Config').first().json.live_match }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "86ad2d15-248e-47f0-a601-00c5c6603415",
      "name": "Wait Deploy",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2688,
        80
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 45,
        "unit": "seconds"
      },
      "webhookId": "605c62fd-9ddc-4eea-92a0-d03e7dfcd4ac"
    },
    {
      "id": "ec657010-eda5-4d69-9ea8-b69bf61da8ae",
      "name": "Get Live Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2912,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.live_url + '?t=' + Date.now() }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "32a88f24-f43e-4f8c-b505-4bff95670e41",
      "name": "Check Live",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3136,
        0
      ],
      "parameters": {
        "jsCode": "\n// $runIndex counts loop passes; the page is fetched as text, so match is a plain substring.\nconst c = $('Config').first().json;\nconst body = typeof $json.data === 'string' ? $json.data : JSON.stringify($json);\nconst attempt = $runIndex + 1;\nconst live = body.includes(c.live_match);\nreturn [{ json: { state: live ? 'live' : attempt >= c.live_checks ? 'timeout' : 'retry', attempt } }];\n"
      }
    },
    {
      "id": "929aae88-3413-40dd-a4a5-1dd590de0a04",
      "name": "Live?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        3360,
        80
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "retry",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.state }}",
                    "rightValue": "retry",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "done"
        }
      }
    },
    {
      "id": "fa0ce6e6-38bf-423f-bdae-c8ecd5492f45",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        144
      ],
      "parameters": {
        "jsCode": "\nconst sha = $('Committed').first().json.sha;\nlet live = null, attempts = 0;\ntry { const s = $('Check Live').last().json; live = s.state === 'live'; attempts = s.attempt; } catch (e) { /* no live check requested */ }\nreturn [{ json: { sha, live, attempts } }];\n"
      }
    },
    {
      "id": "7d68a08c-b56f-479a-866b-ed1a6bc6a6be",
      "name": "Sticky Note 51bceeee",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        192,
        48
      ],
      "parameters": {
        "content": "## bot-git-commit\nOne atomic commit (blobs → tree → commit → ref, force=false) for bot-owned paths only: `incoming/gallery/`, `content/schedule-changes/`.\nInput: `files[{path, content|b64}]`, `message`, optional `branch`, `live_url` + `live_match` (substring polled every 45 s, `live_checks` times).\nOutput: `{sha, live, attempts}`.",
        "color": 7,
        "width": 384,
        "height": 224
      }
    },
