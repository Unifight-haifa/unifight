        "options": {}
      }
    },
    {
      "id": "717e378e-f0bf-4bfa-96bc-e14be8da6759",
      "name": "Create Commit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1792,
        144
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.cfg.api }}/git/commits",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
