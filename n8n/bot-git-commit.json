            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f81d7650-c9f1-49a7-8851-394dfe4505cd",
      "name": "Get Head Commit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        144
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.cfg.api }}/git/commits/{{ $json.object.sha }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
