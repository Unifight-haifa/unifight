    },
    {
      "id": "b1194521-75d7-4b2f-b164-7304ef7ece03",
      "name": "Blob Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        144
      ],
      "parameters": {
        "jsCode": "\nreturn $('Config').first().json.files.map(f => ({ json: typeof f.b64 === 'string'\n  ? { path: f.path, body: { content: f.b64, encoding: 'base64' } }\n  : { path: f.path, body: { content: f.content, encoding: 'utf-8' } } }));\n"
      }
    },
    {
      "id": "1f9dd0a3-fac3-4c5a-8d0c-15f06d8d8b48",
      "name": "Create Blob",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        144
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.cfg.api }}/git/blobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2026-03-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "33192a3b-5edc-412f-b782-1624ed42b835",
      "name": "Build Tree",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        144
      ],
      "parameters": {
        "jsCode": "\nconst paths = $('Blob Items').all().map(i => i.json.path);\nconst shas = $input.all().map(i => i.json.sha);\nif (shas.length !== paths.length || shas.some(s => !s)) throw new Error('Blob upload failed');\nreturn [{ json: {\n  base_tree: $('Get Head Commit').first().json.tree.sha,\n  tree: paths.map((path, k) => ({ path, mode: '100644', type: 'blob', sha: shas[k] })),\n} }];\n"
      }
    },
    {
      "id": "d56a03fd-8002-4de5-bd00-51f704b961e3",
      "name": "Create Tree",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1568,
        144
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.cfg.api }}/git/trees",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
