    {
      "id": "279775a2-0419-4984-b01b-8d6d6d818a90",
      "name": "Link Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        752
      ],
      "parameters": {
        "jsCode": "\n// The club credential can read far more than the media folder, so only files inside it (root or a month folder) are accepted.\nconst c = $('Classify').first().json;\nconst f = $('Get Drive File').first().json;\nconst parent = $input.first().json;\nconst root = c.cfg.drive_root_id;\nconst mime = String(f.mimeType || '');\nconst parents = Array.isArray(f.parents) ? f.parents : [];\nconst inRoot = parents.includes(root)\n  || (parent.id === parents[0] && parent.mimeType === 'application/vnd.google-apps.folder' && (parent.parents || []).includes(root));\nconst why = !f.id ? 'no access' : !/^(image|video)\\//.test(mime) ? `mime ${mime || '?'}` : !inRoot ? `outside media folder (parent ${parents[0] || '-'})` : '';\nif (why) {\n  return [{ json: { reject: true, reason: why, drive_file_id: c.drive_file_id, author_id: c.author_id, chat_id: c.author_tg,\n    text: `Этот файл не принят: подходят только фото и видео, загруженные в папку клуба «Unifight media» (${c.cfg.drive_root_url}). Загрузите файл туда и пришлите ссылку ещё раз.` } }];\n}\nconst ext = (String(f.name || '').match(/\\.([a-z0-9]{2,5})$/i)?.[1] || mime.split('/')[1]).toLowerCase();\nreturn [{ json: {\n  media_id: `${c.day}-${f.id}`, type: mime.startsWith('video/') ? 'video' : 'photo', status: 'new',\n  author_id: c.author_id, author_tg: c.author_tg, caption: '', tg_file_id: '', tg_unique_id: '', media_group_id: '',\n  drive_file_id: f.id, drive_link: f.webViewLink || `https://drive.google.com/file/d/${f.id}/view`,\n  file_name: `${c.day}_${c.author_id}_${String(f.id).slice(0, 16)}.${ext}`, mime, size_bytes: Number(f.size || 0),\n} }];\n"
      }
    },
