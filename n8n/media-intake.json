    {
      "id": "32a3c53f-9b37-46be-ace7-ecc8d77b887f",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        672
      ],
      "parameters": {
        "jsCode": "\n// Bot API getFile refuses files over 20 MB, so those go to Drive by hand and come back as a link.\nconst cfg = {\n  drive_root_id: 'REPLACE_DRIVE_FOLDER_ID',\n  drive_root_url: 'https://drive.google.com/drive/folders/REPLACE_DRIVE_FOLDER_ID',\n  max_tg_bytes: 20 * 1024 * 1024,\n};\nconst { message: m, publisher: p } = $input.first().json;\nconst day = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Jerusalem' });\nconst base = {\n  cfg, author_id: p.coach_id, author_tg: String(m.chat.id), caption: String(m.caption || m.text || '').trim().slice(0, 500),\n  media_group_id: String(m.media_group_id || ''), month: day.slice(0, 7), day,\n};\nlet f = null;\nif (m.photo?.length) { const ph = m.photo[m.photo.length - 1]; f = { type: 'photo', id: ph.file_id, uid: ph.file_unique_id, size: ph.file_size, mime: 'image/jpeg', ext: 'jpg' }; }\nelse if (m.video || m.video_note) { const v = m.video || m.video_note; f = { type: 'video', id: v.file_id, uid: v.file_unique_id, size: v.file_size, mime: v.mime_type || 'video/mp4', ext: (v.mime_type || 'video/mp4').split('/')[1] }; }\nelse if (m.document && /^(image|video)\\//.test(m.document.mime_type || '')) {\n  const d = m.document;\n  f = { type: d.mime_type.startsWith('video/') ? 'video' : 'photo', id: d.file_id, uid: d.file_unique_id, size: d.file_size, mime: d.mime_type,\n        ext: (String(d.file_name || '').match(/\\.([a-z0-9]{2,5})$/i)?.[1] || d.mime_type.split('/')[1]).toLowerCase() };\n}\nif (f) {\n  const kind = Number(f.size || 0) > cfg.max_tg_bytes ? 'too_big' : 'file';\n  const ext = f.ext.replace(/[^a-z0-9]/gi, '').toLowerCase() || 'bin';\n  return [{ json: { ...base, kind, type: f.type, tg_file_id: f.id, tg_unique_id: f.uid, size_bytes: Number(f.size || 0), mime: f.mime,\n    file_name: `${day}_${p.coach_id}_${f.uid}.${ext}`, media_id: `${day}-${f.uid}` } }];\n}\nconst link = String(m.text || '').match(/drive\\.google\\.com\\/(?:file\\/d\\/|open\\?id=|uc\\?id=)([\\w-]{20,})/);\nif (link) return [{ json: { ...base, kind: 'drive_link', drive_file_id: link[1], caption: '' } }];\nreturn [{ json: { ...base, kind: 'unsupported' } }];\n"
      }
    },
