        2464,
        576
      ],
      "parameters": {
        "jsCode": "\nconst c = $input.first().json;\nconst mb = Math.round(c.size_bytes / 1048576);\nreturn [{ json: { chat_id: c.author_tg, text: [\n  `Файл ${mb} МБ: Telegram не даёт боту скачивать файлы больше 20 МБ.`,\n  `Загрузите оригинал сами в папку клуба: ${c.cfg.drive_root_url}`,\n  'Потом откройте файл в Drive → «Поделиться» → «Копировать ссылку» и пришлите ссылку сюда. Бот его зарегистрирует и отправит на просмотр.',\n].join('\\n') } }];\n"
      }
