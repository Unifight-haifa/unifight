    {
      "id": "76fad051-7557-4d91-976d-c9935e09e903",
      "name": "Resolve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "jsCode": "\n// Map slug or folder to the real folder; the URL slug is the folder name minus its date.\nconst s = $('Normalize').first().json;\nconst res = $input.first().json;\nconst dirs = (Array.isArray(res.body) ? res.body : []).filter(x => x.type === 'dir').map(x => x.name);\nconst folder = s.valid ? (dirs.find(d => d === s.ref || d.replace(/^\\d{4}-\\d{2}-\\d{2}-/, '') === s.ref) || '') : '';\nreturn [{ json: { ...s, folder, valid: !!folder } }];\n"
      }
    },
