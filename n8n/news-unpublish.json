        "url": "=https://api.github.com/repos/{{ $('Normalize').first().json.cfg.repo }}/contents/{{ $json.cfg.news_dir }}?ref={{ $json.cfg.branch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
