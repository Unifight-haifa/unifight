      "_note": "Facebook Graph API node: queryParameters structure and graphApiVersion value unverified; docs list Host URL/Method/Version/Node/Edge. https://docs.n8n.io/integrations/builtin/app-nodes/n8n-nodes-base.facebookgraphapi/"
    },
    {
      "parameters": {
        "jsCode": "\nconst s = $('Resolve').first().json;\nconst p = $('Plan Delete').first().json;\nlet fb = 'не было';\nif (p.fb_post_id) {\n  const r = $('Delete FB Post').first().json;\n  fb = r.success ? 'удалён' : 'не удалось удалить: ' + (r.error?.message || r.error || '?');\n}\nconst ig = p.ig_media_id ? `Instagram: удалите пост вручную в приложении (id ${p.ig_media_id}).` : '';\nreturn [{ json: {\n  channel: s.channel, chat_id: s.chat_id, email: s.email, notify_admin: s.channel !== 'telegram' || !!ig,\n  notify: [`Новость ${s.folder} снята с сайта (обновится через 1–2 минуты).`, `Facebook: пост ${fb}.`, ig].filter(Boolean).join('\\n'),\n  draft: { draft_id: p.draft_id || `unknown-${s.folder}`, folder: s.folder, author_id: '', channel: s.channel,\n           status: 'unpublished', title_en: '', commit_sha: $('Create Commit').first().json.sha,\n           fb_post_id: p.fb_post_id, ig_media_id: p.ig_media_id, error: '' },\n  audit: { actor_id: s.actor_id, action: 'unpublish', target: s.folder, result: 'ok', detail: `fb=${fb}` },\n} }];\n"
      },
