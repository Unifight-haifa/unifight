    {
      "id": "d32d02fa-ed16-46b7-bda0-182d95f70b26",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "\n// Same shape from both entry points.\nconst cfg = { repo: 'Unifight-haifa/unifight', branch: 'main', news_dir: 'src/content/news' };\nlet s;\ntry {\n  const t = $('From Telegram').first().json;\n  s = { folder: t.arg, actor_id: t.coach_id, channel: 'telegram', chat_id: t.chat_id, email: '' };\n} catch (e) {\n  const f = $('Admin Form').first().json, a = $('Find Admin').first().json;\n  s = { folder: f.folder, actor_id: a.coach_id, channel: 'email', chat_id: '', email: a.email };\n}\n// Accept a folder name, a slug or a post URL (/<lang>/news/<slug>/).\ns.ref = String(s.folder || '').trim().replace(/\\/+$/, '').split('/').pop();\ns.valid = /^[a-z0-9-]+$/.test(s.ref);\nreturn [{ json: { ...s, cfg } }];\n"
      }
    },
