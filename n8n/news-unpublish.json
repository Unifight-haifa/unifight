    {
      "parameters": {
        "jsCode": "\nconst s = $('Resolve').first().json;\nconst draft = $('Find Draft').first().json || {};\nconst res = $input.first().json;\nconst files = Array.isArray(res.body) ? res.body.filter(x => x.type === 'file') : [];\nconst base = { channel: s.channel, chat_id: s.chat_id, email: s.email };\nif (!s.valid || res.statusCode !== 200 || !files.length) {\n  return [{ json: { ...base, found: false,\n    notify: `Новость «${s.ref}» не найдена на сайте. Пришлите адрес новости или её slug (часть адреса после /news/).`,\n    audit: { actor_id: s.actor_id, action: 'unpublish', target: s.folder, result: 'not_found', detail: String(res.statusCode) } } }];\n}\nreturn [{ json: { ...base, found: true, fb_post_id: draft.fb_post_id || '', ig_media_id: draft.ig_media_id || '',\n  draft_id: draft.draft_id || '', tree: files.map(x => ({ path: x.path, mode: '100644', type: 'blob', sha: null })) } }];\n"
      },
