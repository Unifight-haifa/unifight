      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "43603499-25d7-460b-8841-829d4bf28deb",
      "name": "Admin Copy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
