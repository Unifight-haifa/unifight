      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "2d147bc2-565b-4b76-821f-61ac46037cfe",
      "name": "Sticky Note 8bce3e78",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        192,
        -96
      ],
      "parameters": {
        "content": "## bot-notify\nShared Telegram notification for the bot. Input per item: `chat_id`, `text`, optional `notify_admin` (copy to the admin chat). Text is HTML-escaped and capped at 4000 chars. Failures never stop the caller.",
        "color": 7,
        "width": 160,
        "height": 224
      }
    }
