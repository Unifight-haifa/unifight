      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nconst p = $('Parse Command').first().json;\nconst photos = JSON.parse(r.photo_ids || '[]');\nconst lines = (r.text || '').trim().split('\\n');\nconst title = (lines.shift() || '').trim();\nconst body = lines.join('\\n').trim();\nif (!r.telegram_id || title.length < 3 || body.length < 20 || !photos.length) {\n  return [{ json: { ok: false } }];\n}\nconst detect = (s) => /[֐-׿]/.test(s) ? 'he' : /[Ѐ-ӿ]/.test(s) ? 'ru' : 'en';\nconst meta = {\n  channel: 'telegram', chat_id: p.chat_id, email: '',\n  author_id: p.coach_id, author_name: p.name,\n  src_lang: r.src_lang || detect(title + ' ' + body),\n  title, body, cover_alt: '', tags: [],\n  draft_id: `tg-${p.telegram_id}-${Date.now()}`,\n};\nreturn photos.map((file_id, index) => ({ json: { ok: true, file_id, index, meta } }));\n"
      }
