    {
      "parameters": {
        "jsCode": "\nconst cur = $input.first().json;\nconst p = $('Parse Command').first().json;\nif (!cur.telegram_id) return [{ json: { save: false, reply: 'Сначала отправьте /new.' } }];\nconst photos = JSON.parse(cur.photo_ids || '[]');\nlet note = '';\nif (p.video) note = 'Видео пока не публикуется автоматически, загрузите его на YouTube вручную. ';\nif (p.photo) {\n  if (photos.length >= 6) note += 'Больше 6 фото нельзя, это фото не добавлено. ';\n  else photos.push(p.photo);\n}\nconst text = p.text ? (cur.text ? cur.text + '\\n\\n' + p.text : p.text) : (cur.text || '');\nreturn [{ json: {\n  save: true, telegram_id: cur.telegram_id, text, photo_ids: JSON.stringify(photos),\n  reply: `${note}Принято: текст ${text.length} симв., фото ${photos.length}. Готово — /done.`,\n} }];\n"
      },
