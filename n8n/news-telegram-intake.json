    {
      "id": "1d1501f3-d796-4feb-93e5-3a2fbc1ccc7e",
      "name": "Reply Help",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        960
      ],
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "Команды:\n/new — новая новость (можно /new ru, если язык текста не определился)\n/done — отправить на перевод и предпросмотр\n/cancel — удалить черновик\n/schedule — разовое изменение расписания (отмена, перенос, доп. тренировка, объявление)\n/unpublish <адрес или slug> — снять новость (только админы)\n\nФото и видео без /new (можно альбомом) сохраняются в папку клуба, утверждающие решают: на сайт, на YouTube или оставить в папке. Видео больше 20 МБ загрузите в папку сами и пришлите ссылку.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "webhookId": "7272cad0-b451-467b-a43b-957f3863af8c",
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "52817bfd-a940-49bb-ad83-3ec9d747f8be",
      "name": "Reply New",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "chatId": "={{ $('Parse Command').first().json.chat_id }}",
        "text": "Новая новость. Пришлите текст: первая строка — заголовок, дальше — сама новость. Затем от 1 до 6 фото, первое станет обложкой. Когда всё готово — /done, отменить — /cancel.",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "webhookId": "7c56b41d-42d7-4c6b-bac8-3df5a31f40a6",
      "credentials": {
        "telegramApi": {
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "f166a420-111a-4e85-ac85-fb9c442cd1e5",
      "name": "Append To Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "parameters": {
        "jsCode": "\nconst cur = $input.first().json;\nconst p = $('Parse Command').first().json;\nconst m = $('Telegram Trigger').first().json.message;\n// Without an open news draft, photos, videos and Drive links go to the club media folder.\nconst isMedia = !!(p.photo || p.video || /^video\\//.test(m.document?.mime_type || '') || /drive\\.google\\.com\\//.test(p.text));\nif (!cur.telegram_id) {\n  if (isMedia) return [{ json: { save: false, media: true } }];\n  return [{ json: { save: false, reply: 'Сначала отправьте /new для новости. Фото и видео без /new сохраняются в папку клуба.' } }];\n}\nconst photos = JSON.parse(cur.photo_ids || '[]');\nlet note = '';\nif (p.video) note = 'Видео в новость не добавляется. Пришлите его после /done или /cancel, оно уйдёт в папку клуба. ';\nif (p.photo) {\n  if (photos.length >= 6) note += 'Больше 6 фото нельзя, это фото не добавлено. ';\n  else photos.push(p.photo);\n}\nconst text = p.text ? (cur.text ? cur.text + '\\n\\n' + p.text : p.text) : (cur.text || '');\nreturn [{ json: {\n  save: true, telegram_id: cur.telegram_id, text, photo_ids: JSON.stringify(photos),\n  reply: `${note}Принято: текст ${text.length} симв., фото ${photos.length}. Готово — /done.`,\n} }];\n"
      }
    },
