    {
      "id": "83fa946f-3f5f-4447-a513-cc7112ba19cb",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        280
      ],
      "parameters": {
        "jsCode": "\n// One update = one command or one piece of content for the open draft.\nconst m = $('Telegram Trigger').first().json.message;\nconst p = $input.first().json;\nconst raw = (m.text || m.caption || '').trim();\nconst c = raw.match(/^\\/(\\w+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\nlet photo = '';\nif (m.photo && m.photo.length) photo = m.photo[m.photo.length - 1].file_id;\nelse if (m.document && (m.document.mime_type || '').startsWith('image/')) photo = m.document.file_id;\nreturn [{ json: {\n  cmd: c ? c[1].toLowerCase() : 'content',\n  arg: c ? c[2].trim() : '',\n  text: c ? '' : raw,\n  photo,\n  video: !!(m.video || m.video_note),\n  chat_id: String(m.chat.id),\n  telegram_id: String(m.from.id),\n  coach_id: p.coach_id, name: p.name || '', role: p.role, lang: p.lang || '',\n} }];\n"
      }
    },
