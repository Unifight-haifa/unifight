    {
      "parameters": {
        "jsCode": "\nconst x = $input.first().json;\nconst msg = [\n  `Сбой: ${x.workflow?.name || '?'}`,\n  `Шаг: ${x.execution?.lastNodeExecuted || '?'}`,\n  `Ошибка: ${String(x.execution?.error?.message || '?').slice(0, 500)}`,\n  x.execution?.url || '',\n].filter(Boolean).join('\\n');\nreturn [{ json: { msg } }];\n"
      },
      "id": "de2754c7-ccec-5f7a-bca0-ca448d5a17e0",
