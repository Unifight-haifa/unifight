    {
      "parameters": {
        "jsCode": "\n// Publish input: one item per image (binary \"data\"), cover first, max 6.\nconst f = $('News Form').first();\nconst p = $input.first().json;\nconst v = f.json;\nconst keys = Object.keys(f.binary || {});\nconst order = [...keys.filter(k => k.startsWith('cover')), ...keys.filter(k => !k.startsWith('cover'))].slice(0, 6);\nif (!order.length) throw new Error('Form submitted without a cover image');\nconst lang = (String(v.lang || '').match(/\\((he|ru|en)\\)/) || [])[1] || p.lang || 'he';\nconst meta = {\n  channel: 'email', chat_id: '', email: p.email,\n  author_id: p.coach_id, author_name: p.name || '',\n  src_lang: lang,\n  title: String(v.title || '').trim(), body: String(v.body || '').trim(),\n  cover_alt: String(v.cover_alt || '').trim(),\n  tags: String(v.tags || '').split(',').map(t => t.trim()).filter(Boolean).slice(0, 8),\n  draft_id: `form-${p.coach_id}-${Date.now()}`,\n};\nreturn order.map((k, index) => ({ json: { ...meta, index }, binary: { data: f.binary[k] } }));\n"
      },
      "id": "7becbdb3-42c1-55e7-bdd1-cadf703945bf",
